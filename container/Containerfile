# --- Build stage ---
FROM docker.io/library/golang:1.25-bookworm AS builder

RUN go install go.opentelemetry.io/collector/cmd/builder@v0.148.0

WORKDIR /build
COPY . .

# Run from repo root so path: ./receiver/tetragonreceiver resolves correctly
RUN builder \
    --config distribution/builder-config.yaml \
    --output-path /tmp/dist \
    --skip-strict-versioning

# --- Runtime stage ---
# Use :latest (root) base, then set USER to a low UID.
# :nonroot uses UID 65534, which forces podman UserNS=auto to map 65535+ UIDs.
# UID 1000 keeps the mapping small (1001 UIDs).
FROM gcr.io/distroless/static-debian12:latest

COPY --from=builder /tmp/dist/otelcol-tetragon /usr/local/bin/otelcol-tetragon

USER 1000:1000

# Health check: The OTel Collector health_check extension listens on port 13133.
# Distroless images have no shell, wget, or curl — Dockerfile HEALTHCHECK cannot
# work. Use Kubernetes readiness/liveness probes targeting port 13133 instead.
EXPOSE 13133

ENTRYPOINT ["/usr/local/bin/otelcol-tetragon"]
CMD ["--config", "/etc/otelcol/config.yaml"]
