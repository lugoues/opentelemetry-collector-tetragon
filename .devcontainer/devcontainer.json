// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Debian",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/lugoues/devcontainer-features/mise:1.0.7": {},
		"ghcr.io/devcontainers/features/docker-in-docker:4.1.0": {
			"installDockerBuildx": true,
			"version": "latest",
			"dockerDashComposeVersion": "v2",
			"moby": false
		}
	},
	"runArgs": [
		// To work with rootless podman you will need
		// to set the sollowing in your environment.
		// export DEVCONTAINER_USERNS_ARG=--userns=keep-id:uid=$(id -u)
		"${localEnv:DEVCONTAINER_USERNS_ARG}"
	]
}